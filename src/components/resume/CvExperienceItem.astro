---
interface Props {
	company: string;
	role: string;
	date: string;
	summary?: string;
	responsibilities?: string[];
	solved?: string[];
	bullets?: string[];
}

const { company, role, date, summary, responsibilities, solved, bullets } = Astro.props;

// Inline markup only: links + bold.
const parseInline = (text: string) =>
	text
		.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank" class="text-blue-600 hover:underline">$1</a>')
		.replace(/\*\*(.*?)\*\*/g, "<strong>$1</strong>");
---
<div class="mb-4 break-inside-avoid">
  <div class="flex flex-col sm:flex-row sm:justify-between sm:items-baseline">
    <div>
      <div class="font-bold text-gray-900">{company}</div>
      <div class="text-sm text-gray-600">{role}</div>
    </div>
    <span class="text-sm text-gray-500 shrink-0">{date}</span>
  </div>

  {summary && <p class="text-sm text-gray-800 font-medium mt-0.5" set:html={parseInline(summary)}></p>}

  {responsibilities && responsibilities.length > 0 && (
    <div class="mt-1.5">
      <div class="text-xs font-bold text-gray-500 uppercase tracking-wide">담당</div>
      <ul class="list-disc list-outside ml-5 mt-0.5 space-y-0.5 text-sm text-gray-600 leading-relaxed">
        {responsibilities.map(b => <li set:html={parseInline(b)}></li>)}
      </ul>
    </div>
  )}

  {solved && solved.length > 0 && (
    <div class="mt-1.5">
      <div class="text-xs font-bold text-emerald-700 uppercase tracking-wide">해결</div>
      <ul class="list-disc list-outside ml-5 mt-0.5 space-y-0.5 text-sm text-gray-600 leading-relaxed marker:text-emerald-500">
        {solved.map(b => <li set:html={parseInline(b)}></li>)}
      </ul>
    </div>
  )}

  {bullets && bullets.length > 0 && (
    <ul class="list-disc list-outside ml-5 mt-1 space-y-0.5 text-sm text-gray-600 leading-relaxed">
      {bullets.map(b => <li set:html={parseInline(b)}></li>)}
    </ul>
  )}
</div>
