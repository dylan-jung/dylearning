---
interface ActivityDetail {
	label?: string;
	content: string | string[];
}

interface Activity {
	summary: string;
	details?: ActivityDetail[];
	group?: string;
	groupDesc?: string;
	groupIntro?: string;
	featured?: boolean;
}

interface Props {
	company: string;
	role: string;
	date: string;
	intro?: string;
	activities?: Activity[];
	techStack?: { name: string; description: string }[];
	relatedLinks?: { text: string; url: string }[];
	forcePageBreak?: boolean;
}
const { company, role, date, intro, activities, techStack, relatedLinks, forcePageBreak = false } = Astro.props;

// Inline markup only: links + bold (no newline handling)
const parseInline = (text: string) => {
	let parsed = text.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank" class="text-blue-600 hover:underline">$1</a>');
	parsed = parsed.replace(/\*\*(.*?)\*\*/g, "<strong>$1</strong>");
	return parsed;
};

const parseContent = (text: string) => parseInline(text).replace(/\n/g, "<br />");

// If the content is a "1. ... \n2. ... \n3. ..." numbered list, return the
// parsed item HTML strings; otherwise null (caller falls back to parseContent).
const parseListItems = (text: string): string[] | null => {
	const trimmed = text.trim();
	if (!/^\d+\.\s/.test(trimmed)) return null;
	const parts = trimmed.split(/\n(?=\d+\.\s)/);
	if (parts.length < 2) return null;
	return parts.map(part => parseInline(part.replace(/^\d+\.\s*/, "").trim()));
};

// content may be a plain string (optionally a "1. ... \n2. ..." list) or a string[].
const getListItems = (content: string | string[]): string[] | null => (Array.isArray(content) ? content.map(parseInline) : parseListItems(content));

// Consecutive activities sharing a `group` render under one project heading;
// activities without `group` fall into an unnamed group (no heading).
type ActivityGroup = { name?: string; desc?: string; intro?: string; items: Activity[] };
const activityGroups: ActivityGroup[] = [];
for (const activity of activities ?? []) {
	const current = activityGroups[activityGroups.length - 1];
	if (!current || (activity.group && activity.group !== current.name)) {
		activityGroups.push({ name: activity.group, desc: activity.groupDesc, intro: activity.groupIntro, items: [activity] });
	} else {
		current.items.push(activity);
	}
}
---
<div class:list={["mb-8", { "print:break-inside-avoid print:break-after-page": forcePageBreak }]}>
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-baseline mb-2 border-b border-gray-200 pb-2 break-inside-avoid">
    <div class="flex flex-col">
        <h3 class="text-2xl font-bold text-gray-900">{company}</h3>
        <span class="text-xl font-semibold text-gray-700">{role}</span>
    </div>
    <span class="text-md font-medium text-gray-500 mt-1 sm:mt-0">{date}</span>
  </div>
  
  {intro && (
    <div class="mb-4 bg-gray-50 p-4 rounded-lg border border-gray-100 break-inside-avoid">
      <h4 class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Introduction</h4>
      <p class="text-gray-700 text-sm leading-relaxed whitespace-pre-line" set:html={parseContent(intro)}></p>
    </div>
  )}
  
  {activities && activities.length > 0 && (
    <div class="mb-4">
      <h4 class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-2 break-inside-avoid">Key Activities</h4>
      <div class="space-y-6">
        {activityGroups.map(group => (
          <div>
            {group.name && (
              <div class="mb-3 break-inside-avoid">
                <div class="flex flex-col sm:flex-row sm:justify-between sm:items-baseline border-b border-gray-200 pb-1.5">
                  <div class="text-sm font-bold text-gray-900">{group.name}</div>
                  {group.desc && <div class="text-xs font-medium text-gray-500 mt-0.5 sm:mt-0">{group.desc}</div>}
                </div>
                {group.intro && (
                  <div class="mt-2 bg-gray-50 p-3 rounded-lg border border-gray-100">
                    <p class="text-gray-700 text-sm leading-relaxed whitespace-pre-line" set:html={parseContent(group.intro)}></p>
                  </div>
                )}
              </div>
            )}
            <div class="space-y-4">
              {group.items.map(activity => (
                <div class="text-gray-700 text-sm leading-relaxed break-inside-avoid">
                  <div class="font-bold mb-1">
                    {activity.featured && (
                      <span class="inline-block align-middle mr-1.5 -mt-0.5 text-[10px] font-semibold uppercase tracking-wider text-white bg-gray-900 rounded-sm px-1.5 py-0.5 whitespace-nowrap">Featured</span>
                    )}
                    <span set:html={activity.summary}></span>
                  </div>
                  {activity.details && (
                      <ul class="list-disc list-inside ml-2 space-y-1 text-gray-600">
                          {activity.details.map(detail => {
                              const listItems = getListItems(detail.content);
                              return (
                                  <li class="pl-1 -indent-5 ml-5">
                                      {detail.label && <strong class="text-gray-700 mr-1">{detail.label}:</strong>}
                                      {listItems ? (
                                          <ol class="list-decimal list-outside mt-1.5 ml-5 space-y-1 indent-0 marker:text-gray-400 marker:font-medium">
                                              {listItems.map(item => (
                                                  <li class="pl-1" set:html={item}></li>
                                              ))}
                                          </ol>
                                      ) : (
                                          <span set:html={parseContent(detail.content as string)}></span>
                                      )}
                                  </li>
                              );
                          })}
                      </ul>
                  )}
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  )}

  {techStack && techStack.length > 0 && (
    <div class="mb-4 break-inside-avoid">
        <h4 class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Tech Stack & Usage</h4>
        <dl class="grid grid-cols-1 sm:grid-cols-[120px_1fr] gap-x-4 gap-y-2 text-sm">
        {techStack.map(tech => (
            <>
                <dt class="font-bold text-gray-800 bg-gray-100 px-2 py-1 rounded self-start text-center text-xs">{tech.name}</dt>
                <dd class="text-gray-700 pt-0.5">{tech.description}</dd>
            </>
        ))}
        </dl>
    </div>
  )}

  {relatedLinks && relatedLinks.length > 0 && (
    <div class="mt-3 pt-3 border-t border-gray-50 break-inside-avoid">
      <span class="text-xs font-bold text-gray-500 uppercase tracking-wider mr-2">Related Posts:</span>
      <div class="flex flex-wrap gap-x-3 gap-y-1 inline-flex">
      {relatedLinks.map((link, index) => (
        <a href={link.url} target="_blank" class="text-sm text-blue-600 hover:text-blue-800 hover:underline flex items-center">
            {link.text} <span class="text-[10px] ml-0.5">↗</span>
        </a>
      ))}
      </div>
    </div>
  )}
</div>
