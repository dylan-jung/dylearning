---
import { getCollection } from "astro:content";
import config, { monolocale } from "$config";
import Base from "$layouts/Base.astro";
import Note from "$components/Note.svelte";
import i18nit from "$i18n";

export async function getStaticPaths() {
	// Create path for each locale, omitting default locale from URL
	return config.i18n.locales.map(locale => ({ params: { locale: config.i18n.defaultLocale === locale ? undefined : locale } }));
}

const { locale = config.i18n.defaultLocale } = Astro.params;

const t = i18nit(locale);

const notes = await getCollection("note", note => {
	// Filter by publication status and locale
	let published = !note.data.draft;
	let localed = monolocale || note.id.split("/")[0] === locale;

	return published && localed;
});

// Map hierarchical tag prefixes (e.g. "tech/backend") to a small set of reader-facing categories
const CATEGORY: Record<string, string> = {
	tech: "기술",
	learn: "학습",
	essay: "에세이",
	short: "에세이", // short/idea → 에세이로 합침
	book: "책",
	retrospective: "회고"
};
const CATEGORY_ORDER = ["기술", "학습", "에세이", "책", "회고"];
const categoriesOf = (tags?: string[]) => Array.from(new Set((tags ?? []).map(tag => CATEGORY[tag.split("/")[0]]).filter(Boolean)));

// Standardize note structure
let list = notes.map(note => ({
	id: note.id,
	data: {
		title: note.data.title,
		timestamp: note.data.timestamp,
		series: note.data.series,
		categories: categoriesOf(note.data.tags),
		sensitive: note.data.sensitive,
		top: note.data.top
	}
}));

// Extract all unique series and categories from the filtered notes
const series = Array.from(new Set(notes.map(note => note.data.series).filter((series): series is string => Boolean(series)))).sort();
const categories = CATEGORY_ORDER.filter(category => list.some(note => note.data.categories.includes(category)));
---

<Base title={t("navigation.note")} {locale}>
	<main class="flex flex-col grow">
		<Note client:load {locale} notes={list} {series} {categories} />
	</main>
</Base>
