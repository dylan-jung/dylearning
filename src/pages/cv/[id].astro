---
import { getCollection } from "astro:content";
import ResumeLayout from "../../layouts/ResumeLayout.astro";
import CvBody from "../../components/resume/CvBody.astro";

export async function getStaticPaths() {
	const entries = await getCollection("cv");
	return entries.map(entry => ({
		params: { id: entry.id },
		props: { cv: entry.data }
	}));
}

const { cv } = Astro.props;
---

<ResumeLayout title={`${cv.header.name} - CV`} description={cv.introLines?.join(" ") || "CV"}>
  <CvBody cv={cv} />
</ResumeLayout>
