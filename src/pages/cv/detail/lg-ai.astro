---
// 단일 문서(2쪽) — LG AI Research 인턴십. 임원·테크리드 보고용 (성과 중심).
// 로고는 public/lg-ai-research-logo.png
const LOGO_SRC = "/lg-ai-research-logo.png";

// 각 phase: points = [{ title?, motive, action, result, links?, todo? }]
// motive/action/result 는 문자열 또는 문자열 배열(불렛).
const phases = [
	{
		period: "2026.02 — 2026.04",
		title: "ChatEXAONE CLI 제작 및 운영",
		desc: "ChatEXAONE이 long-horizon 코딩 태스크를 수행하도록 모델을 학습·고도화하는 과제.",
		points: [
			{
				title: "Opencode 하네스 분석·데이터 생성 가이드",
				motive: "데이터 생성 전략 수립에 앞서 에이전트 하네스(에이전트의 도구 사용·실행 골격)에 대한 깊은 이해가 선행 요구됨.",
				action: [
					"Opencode 하네스의 내부 로직(구조·Compaction·Skills·MCP)을 기술적으로 깊이 분석하고, 동작 원리를 처음부터 끝까지 팀에 설명·공유해 데이터 생성 가이드라인을 정립",
					"오픈소스(Opencode) 내부 로직을 직접 수정해 데이터 생성에 용이하도록 개조"
				],
				result: "Compaction / Skill / Subagent 등 복잡한 동작 메커니즘에 대한 **타겟 데이터 생성 기반 확립**."
			},
			{
				title: "Agent Skill 학습 데이터셋 생산",
				motive: "Agent Skill(필요 기능을 불러 쓰는 모듈) 역량 수요가 높아 관련 학습 데이터가 우선순위로 요구됨.",
				action: [
					"Skills 관련 repo·레퍼런스를 수집·분류하고, skill 이름 지정만으로 자동 로드되는 생성 파이프라인에 연동",
					"해당 파이프라인으로 Skills 타겟 학습 데이터를 생산"
				],
				result: "우선순위 높던 Skills 역량의 학습 데이터 확보 및 학습 후 **정상 동작 검증 완료**."
			},
			{
				title: "데이터 자동 생산 파이프라인·실행 인프라 (Dagster)",
				motive: "수작업 실행·검증으로는 학습 데이터의 양·품질을 안정적으로 확보 불가.",
				action: [
					"생성 → 정합성 검사 → 2단 품질 검증 → 재시도가 무중단으로 도는 Data Flywheel 구축 (Dagster)",
					"2단 품질 검증: 비용·편향 균형을 위한 fallback 기반 이중 Agent Judge verification 설계 (weak verifier → strong verifier)",
					"멀티턴 데이터 생성: 턴별 도커 이미지·trajectory를 저장(노드 볼륨 한계 → Docker Registry + GCS에 효율 저장)해 follow-up 질문을 상태 복원으로 이어서 실행",
					"에이전트를 대량 격리 실행하고, 서빙은 동일 작업을 동일 엔진으로 라우팅해 캐시 재활용"
				],
				result: [
					"5일간 gold ~1,400건 생산, 비용 ~$1,500(전량 Claude Sonnet 추정) → **~$500 (~67%↓)**",
					"재시도로 문제당 확보율(pass@k) **68.5%(k=1) → 93.2%(k=3)**",
					"서빙 처리량 **~10%↑**, 데이터 생산을 **1인 자동화 체계**로 전환 (GPU 풀가동 지속)"
				]
			},
			{
				title: "Opencode 버그·호환성 대응",
				motive: "",
				action: [
					"Opencode 자체 버그 수정: 파일이 바뀔 때마다 git 명령을 정리 없이 계속 실행해 좀비가 쌓이는 버그를 직접 패치",
					"Opencode 버전 불일치 동작 오류(session id 누락·reasoning 포맷 불일치 등)를 직접 진단하고 어댑터 레이어를 추가해 우회"
				],
				result: ""
			},
			{
				title: "Agent Judge (실행 기반 평가자) 구축",
				motive: "",
				action: [
					"에이전트가 만든 코드를 실제로 실행해 '동작 여부'로 채점하는 평가자 설계 (코드만 읽고 채점하거나 고정 테스트만 돌리는 방식의 한계 보완, w. 원기님)",
					"코드를 실제 저장소에 적용·빌드·테스트하고, 필요하면 검증 테스트까지 직접 만들어 실행해 결과·과정·설명을 종합 평가"
				],
				result: ""
			},
			{
				title: "서비스 운영 (Coding Agent CLI)",
				motive: "",
				action: [
					"개발·데이터·운영 전반의 end-to-end 활용 사례를 대표 User Case로 구조화 (사용자 가이드)",
					"장애 식별 및 원인 파악: 스트리밍 응답에 토큰 사용량(usage)이 빠져 자동 압축(compaction)이 트리거되지 않아 긴 세션이 깨지던 문제를 직접 진단"
				],
				result: ""
			},
			{
				title: "공용 서버 모니터링·장애 알림 구축",
				motive: "여러 작업이 함께 쓰는 서버가 느려지거나 죽어도 즉시 인지할 방법이 없었음.",
				action: "Netdata로 서버 상태를 실시간 수집하고, 부하 원인을 자동 진단하는 Claude Code 스킬과 Slack 장애 알림을 연동.",
				result: "이상을 조기에 감지해 **장애로 번지기 전에 대응**."
			},
			{
				title: "남은 기간 계획 (7월~)",
				todo: [
					"공개된 ChatEXAONE CLI 운영·디버깅·개선에 집중",
					"A100 추론 자원 효율화: DCGM exporter·Grafana 기반 GPU 관측 인프라 구축 완료, 활용률 병목 분석을 통한 최적화 예정"
				]
			}
		]
	},
	{
		period: "2026.05 — 2026.06",
		title: "독자 파운데이션 모델 K Exaone 2차수",
		points: [
			{
				title: "TB 학습 데이터 생성·결과 분석 이터레이션",
				motive: "다양한 도메인을 포괄해야 해 공개 데이터셋만으로는 부족했고, 타겟 학습 데이터의 직접 생산이 요구됨.",
				action: [
					"태스크 생성 → trajectory 분석으로 데이터 사용 가능성·부족분을 진단하는 데이터 생성 파이프라인 설계 (담당: 수학·최적화·과학연산·게임)",
					"생성 → 학습(SFT) → 결과 분석으로 약점 도메인·부족 데이터를 찾아 재생성하는 사이클을 반복하며 데이터셋을 고도화",
					"Claude Code의 Skill·Goal로 생성·분석·재생성 워크플로우를 자동화해 이터레이션 속도·반복성을 확보"
				],
				result: ["**44k 규모 SFT/RL 데이터셋** 전달", "담당 도메인 데이터 기여: TB 점수 **SFT 전 14.3 → 후 39.3** (RL 진행 중)"]
			},
			{
				title: "대규모 실행 인프라 구축 (Self-hosted Daytona)",
				motive: "수천 개 에이전트를 동시에 굴릴 전용 대규모 실행 인프라가 필요.",
				action: [
					"EKS 기반 self-hosted Daytona 구축·운영 + 관측 스택(Grafana 등)·Control Plane 대시보드 선구축, 안정성 체크리스트·모니터링 지표 합의 (w. 용우님)",
					"스케줄러 가중치 재설계로 노드 간 sandbox 부하 분산",
					"대규모 운영 이슈 직접 디버깅: 노드 unresponsive, ingress-nginx, Daytona(OSS) 버그 등",
					"외부 화이트리스트 통과용 고정 IP를 노드 기동 시 자동 부여 (kubeip)",
					"샌드박스가 서버(노드) 권한에 닿지 못하도록 접근 차단 (보안)"
				],
				result: [
					"최대 **8,000+ 동시 실행** 기반 마련 + 대규모 운영 안정화",
					"노드 고정 IP 자동화(NAT 비용↓), 샌드박스 권한 접근 **100% 차단**"
				]
			},
			{
				title: "빌드·이미지 파이프라인 최적화 (빌드 서비스 분리 + Harbor S3)",
				motive: "수만 건 실패를 분석하니 대부분 빌드·레지스트리 발(이미지 pull 거부 등)이었고, 실행마다 끼는 무거운 빌드가 최대 병목·비용 요인 (빌드 대기 P95 93분, 일 1,500만원).",
				action: [
					"빌드를 실행 경로에서 분리한 전용 서비스로 재설계: 환경 사전 빌드·캐시 공유로 중복 빌드 제거",
					"Harbor 레지스트리를 S3로 전환: 단일 볼륨 제약 제거·다중 replica 확장, 전환 중 내부 트래픽·인증 이슈까지 해결"
				],
				result: [
					"빌드 대기 P95 **93분 → 4.4분 (-95%)**, 에러율 **16.3% → 0.47%**",
					"일 비용 **1,500만 → 200만원 (~7.5배↓)**, 노드 256 → 32, 클러스터 전체 다운 1회/일 → 0건",
					"동시 푸시 병목 해소, 레지스트리 **~133TB / 약 46만 이미지** 안정 운영"
				]
			}
		]
	}
];

const arr = v => (Array.isArray(v) ? v : v ? [v] : []);
const md = s => String(s).replace(/\*\*(.+?)\*\*/g, "<b>$1</b>");

// 연구 역량(데이터·모델) vs 엔지니어링 역량(인프라·운영) — 제목으로 매핑
const RESEARCH = new Set([
	"Opencode 하네스 분석·데이터 생성 가이드",
	"Agent Skill 학습 데이터셋 생산",
	"Agent Judge (실행 기반 평가자) 구축",
	"TB 학습 데이터 생성·결과 분석 이터레이션"
]);
const trackOf = t => (RESEARCH.has(t) ? "research" : "eng");
const rankOf = pt => (pt.todo ? 2 : trackOf(pt.title) === "research" ? 0 : 1);
const trackLabel = pt => (trackOf(pt.title) === "research" ? "연구" : "엔지니어링");
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content="LG AI Research 인턴십 활동 정리" />
    <title>LG AI Research · Internship</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      :root {
        --lg: #a50034;
        --ink: #18181c;
        --muted: #5a5a64;
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        font-family: "Inter", "Pretendard", sans-serif;
        color: var(--ink);
        background: #ececef;
        -webkit-font-smoothing: antialiased;
      }
      .page {
        max-width: 800px;
        margin: 24px auto;
        background: #fff;
        padding: 32px 44px 40px;
      }

      /* ── Header ── */
      .brand img {
        height: 22px;
        width: auto;
        display: block;
      }
      .brand .fallback {
        font-weight: 800;
        font-size: 15px;
      }
      .brand .fallback b {
        color: var(--lg);
      }
      h1 {
        margin: 14px 0 6px;
        font-size: 21px;
        font-weight: 800;
        letter-spacing: -0.02em;
      }
      .meta {
        font-size: 12.5px;
        color: var(--muted);
      }
      .meta b {
        color: var(--lg);
      }
      .legend {
        display: flex;
        gap: 16px;
        margin-top: 8px;
        font-size: 11.5px;
        font-weight: 600;
        color: var(--muted);
      }
      .legend .dot {
        display: inline-block;
        width: 8px;
        height: 8px;
        border-radius: 2px;
        margin-right: 6px;
        vertical-align: middle;
      }
      .legend .dot.research {
        background: #64748b;
      }
      .legend .dot.eng {
        background: var(--lg);
      }

      /* ── Phase ── */
      .phase {
        margin-top: 26px;
      }
      .phase-head {
        display: flex;
        align-items: baseline;
        gap: 10px;
        margin-bottom: 8px;
      }
      .phase-head .no {
        font-size: 11px;
        font-weight: 800;
        color: #fff;
        background: var(--lg);
        padding: 2px 8px;
        border-radius: 3px;
        letter-spacing: 0.02em;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }
      .phase-head .period {
        font-size: 12px;
        font-weight: 700;
        color: var(--lg);
        font-variant-numeric: tabular-nums;
      }
      .phase-head .title {
        font-size: 15.5px;
        font-weight: 800;
        letter-spacing: -0.01em;
      }
      .phase-desc {
        margin: 0 0 10px;
        color: var(--muted);
        font-size: 12px;
        line-height: 1.5;
      }

      /* ── 항목 (동기 → 액션 → 결과) ── */
      ol.points {
        margin: 0;
        padding-left: 0;
        list-style: none;
      }
      ol.points > li {
        margin-bottom: 14px;
      }
      li.grp-div {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 2px 0 11px;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--muted);
      }
      li.grp-div::after {
        content: "";
        flex: 1;
        height: 1px;
        background: #e2e2e7;
      }
      .pt-title {
        font-size: 13.5px;
        font-weight: 800;
        color: #1f1f25;
        margin-bottom: 5px;
        letter-spacing: -0.01em;
      }
      .pt-title .badge {
        margin-left: 7px;
        font-size: 10px;
        font-weight: 700;
        color: var(--lg);
        border: 1px solid var(--lg);
        border-radius: 999px;
        padding: 1px 7px;
        vertical-align: middle;
      }
      li.is-todo .pt-title {
        color: var(--lg);
      }
      ul.todo {
        margin: 0;
        padding-left: 16px;
        list-style: none;
      }
      ul.todo > li {
        position: relative;
        font-size: 12.5px;
        line-height: 1.6;
        color: #45454f;
        margin-bottom: 2px;
      }
      ul.todo > li::before {
        content: "☐";
        position: absolute;
        left: -16px;
        color: var(--lg);
      }

      /* 동기/액션/결과 — 라벨 칩 + 불렛 */
      .step {
        display: flex;
        align-items: flex-start;
        gap: 8px;
        font-size: 12.5px;
        line-height: 1.55;
        margin-bottom: 6px;
      }
      .step .k {
        flex: none;
        width: 30px;
        font-size: 10.5px;
        font-weight: 700;
        text-align: center;
        border-radius: 3px;
        padding: 1px 0;
        margin-top: 1px;
      }
      .step.motive .k {
        color: var(--muted);
        background: #efeff2;
      }
      .step.action .k {
        color: #fff;
        background: var(--lg);
      }
      .step.result .k {
        color: var(--lg);
        background: #f7dde6;
      }
      .ctx {
        margin: 0 0 5px;
        color: var(--muted);
        font-size: 12px;
        line-height: 1.55;
      }
      .ctx-k {
        font-weight: 700;
        color: var(--muted);
      }
      ul.lv1 {
        margin: 0;
        padding-left: 16px;
        font-size: 12.5px;
        line-height: 1.6;
      }
      ul.lv1 > li {
        color: #25252b;
        margin-bottom: 3px;
      }
      ul.lv1 > li:last-child {
        margin-bottom: 0;
      }
      ul.lv1 > li::marker {
        color: var(--lg);
      }
      ul.lv2 {
        margin: 4px 0 0;
        padding-left: 32px;
        list-style: none;
        font-size: 12px;
        line-height: 1.55;
      }
      ul.lv2 > li {
        position: relative;
        color: #3a3a44;
        margin-bottom: 2px;
      }
      ul.lv2 > li:last-child {
        margin-bottom: 0;
      }
      ul.lv2 > li::before {
        content: "→";
        position: absolute;
        left: -15px;
        color: var(--lg);
        font-weight: 700;
      }
      .links {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin: 6px 0 0 16px;
      }
      .links a {
        font-size: 11px;
        font-weight: 600;
        color: var(--lg);
        text-decoration: none;
        border: 1px solid #f0d6df;
        background: #fdf5f8;
        border-radius: 4px;
        padding: 2px 8px;
      }
      .links a:hover {
        background: #f7dde6;
      }

      .print-btn {
        margin-top: 24px;
        border: 1px solid var(--lg);
        color: var(--lg);
        background: #fff;
        padding: 6px 13px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
      }

      @media (max-width: 640px) {
        .page {
          margin: 0;
          padding: 24px 18px 30px;
        }
        .phase-head {
          flex-wrap: wrap;
        }
      }

      @media print {
        body {
          background: #fff;
        }
        .page {
          margin: 0;
          max-width: 100%;
          padding: 0;
        }
        .no-print {
          display: none !important;
        }
        .phase.break {
          break-before: page;
          page-break-before: always;
          margin-top: 0;
        }
        .phase,
        ol.points > li {
          break-inside: avoid;
        }
      }
    </style>
  </head>
  <body>
    <main class="page">
      <header>
        <div class="brand">
          <img
            src={LOGO_SRC}
            alt="LG AI Research"
            onerror="this.style.display='none';this.nextElementSibling.style.display='block';"
          />
          <span class="fallback" style="display:none;"><b>LG</b> AI Research</span>
        </div>

        <h1>Job Summary</h1>
        <div class="meta">Language Lab, Code & Analysis, Internship</div>
      </header>

      {
        phases.map((p, i) => {
          const ordered = [...p.points].sort((a, b) => rankOf(a) - rankOf(b));
          return (
          <section class={i === 0 ? "phase" : "phase break"}>
            <div class="phase-head">
              <span class="no">PHASE {String(i + 1).padStart(2, "0")}</span>
              <span class="period">{p.period}</span>
              <span class="title">{p.title}</span>
            </div>
            {p.desc && <p class="phase-desc">{p.desc}</p>}

            <ol class="points">
              {ordered.map((pt, idx) => {
                const tk = pt.todo ? "todo" : trackOf(pt.title);
                const prevTk =
                  idx > 0
                    ? ordered[idx - 1].todo
                      ? "todo"
                      : trackOf(ordered[idx - 1].title)
                    : null;
                const showDiv = !pt.todo && tk !== prevTk;
                return (
                  <>
                    {showDiv && (
                      <li class="grp-div">
                        {tk === "research" ? "AI 연구" : "엔지니어링"}
                      </li>
                    )}
                <li class={pt.todo ? "is-todo" : ""}>
                  {pt.title && (
                    <div class="pt-title">
                      {pt.title}
                      {pt.todo && <span class="badge">예정</span>}
                    </div>
                  )}
                  {pt.todo ? (
                    <ul class="todo">
                      {pt.todo.map((t) => (
                        <li set:html={md(t)} />
                      ))}
                    </ul>
                  ) : (
                    <>
                      {arr(pt.motive).length > 0 && (
                        <p class="ctx">
                          <span class="ctx-k">배경:</span>{" "}
                          <span set:html={md(arr(pt.motive).join(" "))} />
                        </p>
                      )}
                      {arr(pt.action).length > 0 && (
                        <ul class="lv1">
                          {arr(pt.action).map((t) => (
                            <li set:html={md(t)} />
                          ))}
                        </ul>
                      )}
                      {arr(pt.result).length > 0 && (
                        <ul class="lv2">
                          {arr(pt.result).map((t) => (
                            <li set:html={md(t)} />
                          ))}
                        </ul>
                      )}
                      {pt.links && (
                        <div class="links">
                          {pt.links.map((l) => (
                            <a href={l.url} target="_blank" rel="noopener noreferrer">
                              {l.label}
                            </a>
                          ))}
                        </div>
                      )}
                    </>
                  )}
                </li>
                  </>
                );
              })}
            </ol>
          </section>
          );
        })
      }

      <button class="print-btn no-print" onclick="window.print()">
        Print to PDF
      </button>
    </main>
  </body>
</html>
