	"소프트웨어 마에스트로 13기 팀 리더 (팀 전원 상위 8% 우수자 선정, 2022)"
];

// 화면에서만 보이는 TODO (인쇄 제외). 전부 완료되면 배열을 비울 것 — 배너가 사라짐.
const todos = [
	"⚠️ 플레이스홀더(가짜 숫자) 4개 — 실측 교체 전 제출 금지",
	"① Skill 활용 유형 성공률 46.9→84.4%(32건): 인하우스 벤치에서 해당 유형 슬라이스로 학습 전/후 실측",
	"② 담당 4개 도메인 TB 11.2→43.5: 도메인 분리 before/after 수치 확보",
	"③ 배합 실험 8회 중 4회 채택: 실제 횟수로 교체",
	"④ '재학습 잡 실행·체크포인트 판독은 본인': 실제로 잡을 직접 돌린 뒤에만 유지, 안 하면 이 구절 삭제 — 38점의 최대 지분",
	"⑤ CLI 운영 정량 지표(사용자·VOC) 하나 확보해 VOC 항목 보강",
	"⑥ 지원 동기 한 줄: 공시·뉴스에서 실제 겪은 답답함으로 교체 (본인 언어)",
	"⑦ 수치 통일: 지미 리텐션 25.3 vs 자소서 10.3 / 모인나 0.9초 vs 400ms"
];

const md = s => String(s).replace(/\*\*(.+?)\*\*/g, "<b>$1</b>");
const pipeStat = p => {
	const m = p.filter(n => n.o === "mine").length;
	const j = p.filter(n => n.o === "joint").length;
	if (m === p.length) return "전 구간 담당";
	return `${p.length}구간 중 ${m} 담당${j ? ` · ${j} 공동` : ""}`;
};
---

<!doctype html>
<html lang="ko">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="robots" content="noindex" />
		<title>정민혁 — ML Engineer (LLM)</title>
		<link
			rel="stylesheet"
			as="style"
			crossorigin
			href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
		/>
		<style is:global>
			:root {
				--ink: #16171d;
				--body: #363a45;
				--muted: #6e7381;
				--faint: #a7abb8;
				--accent: #2b5cf0;
				--accent-deep: #1e46c4;
				--tint: #eef3ff;
				--tint-border: #dbe5ff;
				--chip: #e3ebff;
				--amber-bg: #fdf1e0;
				--amber: #b26205;
				--line: #e7e9ee;
			}
			* {
				box-sizing: border-box;
			}
			html {
				background: #fff;
			}
			body {
				margin: 0;
				font-family:
					"Pretendard Variable",
					Pretendard,
					-apple-system,
					sans-serif;
				color: var(--body);
				font-size: 13.5px;
				line-height: 1.7;
				-webkit-font-smoothing: antialiased;
				font-feature-settings: "tnum";
				letter-spacing: -0.005em;
			}
			b {
				font-weight: 700;
				color: var(--ink);
			}
			.page {
				max-width: 780px;
				margin: 0 auto;
				padding: 60px 52px 80px;
			}

			/* ── TODO 배너 (화면 전용) ── */
			.todo-banner {
				margin-bottom: 32px;
				padding: 14px 18px;
				background: #fff8e6;
				border: 1.5px solid #f0c548;
				border-radius: 12px;
				font-size: 12px;
				line-height: 1.65;
				color: #6b5310;
			}
			.todo-banner .tb-title {
				font-weight: 800;
				font-size: 12.5px;
				margin-bottom: 6px;
				color: #8a6a0c;
			}
			.todo-banner ul {
				margin: 0;
				padding-left: 16px;
			}
			.todo-banner li {
				margin-bottom: 2px;
			}
			.todo-banner li::marker {
				color: #d9a92e;
			}

			/* ── 헤더 ── */
			.head {
				display: flex;
				justify-content: space-between;
				align-items: flex-end;
				gap: 24px;
				padding-bottom: 20px;
				border-bottom: 2.5px solid var(--ink);
			}
			.head h1 {
				margin: 0;
				font-size: 31px;
				font-weight: 800;
				letter-spacing: -0.04em;
				color: var(--ink);
				line-height: 1.1;
			}
			.head .role {
				margin-top: 7px;
				font-size: 14px;
				font-weight: 700;
				color: var(--accent);
			}
			.contacts {
				text-align: right;
				font-size: 12px;
				line-height: 1.85;
				color: var(--muted);
				white-space: nowrap;
			}
			.contacts a {
				color: var(--muted);
				text-decoration: none;
			}
			.contacts a:hover {
				color: var(--accent);
			}
			.guide-line {
				margin-top: 12px;
				font-size: 10.5px;
				font-weight: 600;
				color: var(--faint);
				display: flex;
				flex-wrap: wrap;
				gap: 4px 14px;
			}

			/* ── 섹션 ── */
			section {
				margin-top: 38px;
			}
			h2 {
				display: flex;
				align-items: center;
				gap: 10px;
				margin: 0 0 16px;
				font-size: 14.5px;
				font-weight: 800;
				letter-spacing: -0.01em;
				color: var(--ink);
			}
			h2::before {
				content: "";
				width: 16px;
				height: 3px;
				border-radius: 2px;
				background: var(--accent);
			}

			/* ── Summary ── */
			.summary ul {
				margin: 0;
				padding: 0;
				list-style: none;
			}
			.summary li {
				position: relative;
				padding-left: 20px;
				margin-bottom: 9px;
				font-size: 13.5px;
			}
			.summary li:last-child {
				margin-bottom: 0;
			}
			.summary li::before {
				content: "";
				position: absolute;
				left: 1px;
				top: 10.5px;
				width: 8px;
				height: 2.5px;
				border-radius: 2px;
				background: var(--accent);
			}

			/* ── 경력 ── */
			.career {
				padding-top: 26px;
				margin-top: 26px;
				border-top: 1px solid var(--line);
			}
			.career:first-of-type {
				padding-top: 0;
				margin-top: 0;
				border-top: none;
			}
			.career-head {
				display: flex;
				align-items: baseline;
				gap: 12px;
			}
			.career-head h3 {
				margin: 0;
				font-size: 18px;
				font-weight: 800;
				letter-spacing: -0.02em;
				color: var(--ink);
			}
			.career-head .role {
				font-size: 12.5px;
				font-weight: 500;
				color: var(--muted);
			}
			.career-head .date {
				margin-left: auto;
				font-size: 12px;
				color: var(--faint);
				font-variant-numeric: tabular-nums;
				white-space: nowrap;
			}
			.career-intro {
				margin: 3px 0 0;
				font-size: 12.5px;
				color: var(--muted);
			}
			.career-intro a {
				color: var(--accent);
				font-weight: 600;
				text-decoration: none;
			}

			/* ── 기여 맵 (파이프라인) ── */
			.pipe-wrap {
				margin: 14px 0 4px;
				padding: 15px 18px;
				background: var(--tint);
				border: 1px solid var(--tint-border);
				border-radius: 12px;
			}
			.pipe-title {
				display: flex;
				align-items: baseline;
				gap: 10px;
				margin-bottom: 10px;
			}
			.pipe-title .t {
				font-size: 12px;
				font-weight: 800;
				color: var(--accent-deep);
			}
			.pipe-title .stat {
				font-size: 10.5px;
				font-weight: 700;
				color: var(--accent);
				background: #fff;
				border: 1px solid var(--tint-border);
				border-radius: 999px;
				padding: 1px 9px;
			}
			.pipe-legend {
				margin-left: auto;
				font-size: 10.5px;
				color: var(--muted);
				display: flex;
				gap: 10px;
				align-items: center;
			}
			.pipe-legend i {
				display: inline-block;
				width: 8px;
				height: 8px;
				border-radius: 3px;
				margin-right: 4px;
				vertical-align: -1px;
			}
			.pipe-legend .mine i {
				background: var(--accent);
			}
			.pipe-legend .joint i {
				background: var(--chip);
				border: 1px solid var(--accent);
			}
			.pipe-legend .team i {
				background: transparent;
				border: 1px dashed var(--faint);
			}
			.pipe {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 6px 3px;
			}
			.node {
				font-size: 12px;
				font-weight: 700;
				padding: 5px 13px;
				border-radius: 999px;
				white-space: nowrap;
			}
			.node.mine {
				background: var(--accent);
				color: #fff;
				box-shadow: 0 1px 4px rgba(43, 92, 240, 0.25);
				-webkit-print-color-adjust: exact;
				print-color-adjust: exact;
			}
			.node.joint {
				background: var(--chip);
				color: var(--accent-deep);
				border: 1px solid #c8d7ff;
			}
			.node.team {
				color: var(--faint);
				border: 1px dashed #c4cad6;
				background: rgba(255, 255, 255, 0.6);
			}
			.pipe .arr {
				color: #a9b8dd;
				font-size: 11.5px;
				padding: 0 2px;
			}

			/* ── 항목: 문제 → 방법 → 결과 ── */
			.item {
				margin-top: 22px;
			}
			.item-head {
				display: flex;
				align-items: center;
				gap: 8px;
				flex-wrap: wrap;
				margin-bottom: 9px;
			}
			.item h4 {
				margin: 0;
				font-size: 15px;
				font-weight: 800;
				letter-spacing: -0.02em;
				color: var(--ink);
				margin-right: 2px;
			}
			.tag {
				font-size: 10.5px;
				font-weight: 700;
				border-radius: 999px;
				padding: 2px 10px;
				white-space: nowrap;
			}
			.tag.a {
				background: var(--chip);
				color: var(--accent-deep);
			}
			.tag.s {
				background: #f3f4f7;
				color: var(--muted);
			}
			.tag.o {
				background: var(--amber-bg);
				color: var(--amber);
			}
			.block {
				position: relative;
				padding-left: 54px;
				margin-bottom: 8px;
				font-size: 13px;
			}
			.block:last-child {
				margin-bottom: 0;
			}
			.block .lbl {
				position: absolute;
				left: 0;
				top: 2.5px;
				width: 40px;
				text-align: center;
				font-size: 10.5px;
				font-weight: 800;
				border-radius: 6px;
				padding: 2px 0;
				background: #f3f4f7;
				color: var(--muted);
			}
			.block p {
				margin: 0;
			}
			.block ul {
				margin: 0;
				padding-left: 15px;
			}
			.block li {
				margin-bottom: 3px;
			}
			.block li:last-child {
				margin-bottom: 0;
			}
			.block li::marker {
				color: var(--faint);
			}
			.block.problem p {
				color: var(--muted);
			}
			.block.result {
				background: var(--tint);
				border-radius: 10px;
				padding: 9px 16px 9px 54px;
				margin-top: 11px;
			}
			.block.result .lbl {
				left: 8px;
				top: 10px;
				background: var(--accent);
				color: #fff;
				-webkit-print-color-adjust: exact;
				print-color-adjust: exact;
			}
			.block.result p {
				color: var(--ink);
			}

			/* ── 프로젝트·학력·기타 ── */
			.plain {
				font-size: 13px;
			}
			.edu-row {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				gap: 12px;
				font-size: 13.5px;
			}
			.edu-row .school {
				font-weight: 700;
				color: var(--ink);
			}
			.edu-row .detail {
				font-size: 12px;
				color: var(--muted);
			}
			.etc ul {
				margin: 0;
				padding: 0;
				list-style: none;
			}
			.etc li {
				position: relative;
				padding-left: 19px;
				margin-bottom: 5px;
				font-size: 13px;
			}
			.etc li:last-child {
				margin-bottom: 0;
			}
			.etc li::before {
				content: "";
				position: absolute;
				left: 1px;
				top: 10px;
				width: 7px;
				height: 2.5px;
				border-radius: 2px;
				background: var(--faint);
			}

			.print-btn {
				margin-top: 44px;
				border: 1px solid #d6dae2;
				color: var(--muted);
				background: #fff;
				padding: 8px 18px;
				border-radius: 10px;
				font-size: 12.5px;
				font-weight: 600;
				cursor: pointer;
				font-family: inherit;
			}
			.print-btn:hover {
				border-color: var(--accent);
				color: var(--accent);
			}

			@media (max-width: 640px) {
				.page {
					padding: 36px 22px 56px;
				}
				.head {
					flex-direction: column;
					align-items: flex-start;
					gap: 12px;
				}
				.contacts {
					text-align: left;
				}
				.career-head {
					flex-wrap: wrap;
				}
				.career-head .date {
					margin-left: 0;
					width: 100%;
				}
				.pipe-title {
					flex-wrap: wrap;
				}
				.pipe-legend {
					margin-left: 0;
					width: 100%;
				}
				.block {
					padding-left: 0;
					padding-top: 24px;
				}
				.block .lbl {
					top: 0;
				}
				.block.result {
					padding: 34px 16px 10px;
				}
				.block.result .lbl {
					top: 10px;
				}
			}

			@media print {
				body {
					font-size: 11.5px;
				}
				.page {
					max-width: 100%;
					padding: 0;
				}
				section {
					margin-top: 26px;
				}
				.career {
					padding-top: 20px;
					margin-top: 20px;
				}
				.item {
					margin-top: 15px;
					break-inside: avoid;
				}
				.pipe-wrap {
					break-inside: avoid;
				}
				.node.mine,
				.node.joint,
				.block.result,
				.block.result .lbl,
				.tag,
				.pipe-wrap {
					-webkit-print-color-adjust: exact;
					print-color-adjust: exact;
				}
				.no-print {
					display: none !important;
				}
			}
		</style>
	</head>
	<body>
		<main class="page">
			{
				todos.length > 0 && (
					<aside class="todo-banner no-print">
						<div class="tb-title">🚧 제출 전 TODO — 이 배너가 보이면 아직 초안</div>
						<ul>
							{todos.map((t) => (
								<li>{t}</li>
							))}
						</ul>
					</aside>
				)
			}
			<header>
				<div class="head">
					<div>
						<h1>{header.name}</h1>
						<div class="role">{header.role}</div>
					</div>
					<div class="contacts">
						<a href={`mailto:${header.email}`}>{header.email}</a> · {header.phone}<br />
						<a href={header.github} target="_blank" rel="noopener">github.com/dylan-jung</a> ·
						<a href={header.blog} target="_blank" rel="noopener">blog.dylearning.com</a>
					</div>
				</div>
				<div class="guide-line">
					{guide.map((g) => <span>{g}</span>)}
				</div>
			</header>

			<section class="summary">
				<h2>Summary</h2>
				<ul>
					{summary.map((p) => <li set:html={md(p)} />)}
				</ul>
			</section>

			<section>
				<h2>Experience</h2>
				{
					careers.map((c) => (
						<div class="career">
							<div class="career-head">
								<h3>{c.company}</h3>
								<span class="role">{c.role}</span>
								<span class="date">{c.date}</span>
							</div>
							<p class="career-intro">
								{c.intro}
								{c.link && (
									<>
										{" "}
										<a href={c.link.url} target="_blank" rel="noopener">
											{c.link.label} ↗
										</a>
									</>
								)}
							</p>

							<div class="pipe-wrap">
								<div class="pipe-title">
									<span class="t">전체 구조와 담당 구간</span>
									<span class="stat">{pipeStat(c.pipeline)}</span>
									<span class="pipe-legend">
										<span class="mine"><i />담당</span>
										<span class="joint"><i />공동</span>
										<span class="team"><i />팀</span>
									</span>
								</div>
								<div class="pipe">
									{c.pipeline.map((n, i) => (
										<>
											{i > 0 && <span class="arr">→</span>}
											<span class={`node ${n.o}`}>{n.t}</span>
										</>
									))}
								</div>
							</div>

							{c.items.map((it) => (
								<div class="item">
									<div class="item-head">
										<h4>{it.title}</h4>
										<span class="tag a">{it.area}</span>
										<span class="tag s">{it.stage}</span>
										{it.ops && <span class="tag o">운영 개선</span>}
									</div>
									<div class="block problem">
										<span class="lbl">문제</span>
										<p set:html={md(it.problem)} />
									</div>
									<div class="block">
										<span class="lbl">방법</span>
										<ul>
											{it.method.map((m) => (
												<li set:html={md(m)} />
											))}
										</ul>
									</div>
									<div class="block result">
										<span class="lbl">결과</span>
										<p set:html={md(it.result)} />
									</div>
								</div>
							))}
						</div>
					))
				}
			</section>

			<section>
				<h2>Education</h2>
				<div class="edu-row">
					<span class="school">{education.school}</span>
					<span class="detail">{education.detail}</span>
				</div>
			</section>

			<section class="etc">
				<h2>Awards & Activities</h2>
				<ul>
					{etc.map((e) => <li>{e}</li>)}
				</ul>
			</section>

			<button class="print-btn no-print" onclick="window.print()">Print to PDF</button>
		</main>
	</body>
</html>
