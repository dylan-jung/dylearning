---
import { getEntry } from "astro:content";
import ResumeLayout from "../../layouts/ResumeLayout.astro";
import ResumeHeader from "../../components/resume/ResumeHeader.astro";
import CvExperienceItem from "../../components/resume/CvExperienceItem.astro";
import ResumeItem from "../../components/resume/ResumeItem.astro";
import ResumeSection from "../../components/resume/ResumeSection.astro";

const entry = await getEntry("resume", "default");
if (!entry) {
	throw new Error("Default resume not found");
}
const cv = entry.data;

const experience = [
	{
		company: "LG AI Research",
		role: "Language Lab · Internship",
		date: "2026.02 ~ 2026.08(예정)",
		summary: "Agentic 데이터셋 생성·실행 인프라 담당 (Exaone 4.0 → 독자 파운데이션 모델 K Exaone 2차수)",
		responsibilities: [
			"Agentic 데이터셋 생성·검증 파이프라인 (실행→전처리→2단 검증→gold, Dagster 오케스트레이션)",
			"에이전트 대규모 실행 인프라 (EKS·Daytona, 동시 8,000+)",
			"최적화된 빌드 전용 서비스 직접 설계·구현 (RQ·KEDA·buildkit·공유 S3 캐시)",
			"에이전트 롤아웃 LLM 서빙 (vLLM Data Parallel + prefix 캐시 affinity 라우팅)",
			"K Exaone 2차수 Seed 데이터셋 생성 기여 (Terminal-Bench 중심, SFT·RL)"
		],
		solved: [
			"빌드 대기 **P95 93분 → 4.4분(-95%)**, 실행+빌드 일 비용 **7.5배↓**(1,500→200만원)",
			"동시 실행 **50~100 → 8,000+** 확장, 2일간 trajectory **20만+** 생성",
			"gold 데이터 **5일 1,400건 / $500** (수동 → 엔지니어 1명 자동화)",
			"대규모 운영 트러블슈팅 — Harbor S3 전환, 스케줄러·EIP, Daytona(OSS) 버그 다수 해결"
		]
	},
	{
		company: "씨그로",
		role: "Data·Server Engineer",
		date: "2024.05 ~ 2024.09",
		summary: "이커머스 멀티채널 분석 대시보드의 데이터 파이프라인·백엔드 운영",
		responsibilities: [
			"50+ 채널 크롤링·ETL 파이프라인 운영 및 데이터 적재",
			"채널별 크롤러 개발·유지보수 (스마트스토어·쿠팡·Cafe24·Google/Meta Ads 등)",
			"Prefect 기반 크롤링 스케줄링·오케스트레이션",
			"대시보드 집계 API(FastAPI) 개발",
			"신규 고객사 데이터 연동·온보딩",
			"데이터 스키마·정합성 관리, 채널별 데이터 정규화",
			"쿠버네티스 기반 크롤링 Job 운영",
			"로그·모니터링 체계 구축 (Loki·Grafana)"
		],
		solved: [
			"대시보드 집계 조회 **p99 10s → 1s** (Summary Table 캐싱·증분 갱신)",
			"크롤링 정합성 이슈 티켓 **30건 → 3건 미만**",
			"반복되던 **OOMKilled 장애 해소** — 메모리 원인 진단 + 렌더링 최적화로 근본 해결",
			"장애 인지 **수동 → 알림 기반**으로 전환 (Loki·Grafana)",
			"채널 구조 변경·차단(rate limit·IP·인증)에도 크롤링 안정성 유지"
		]
	},
	{
		company: "리베이스 — 모인나",
		role: "Founder · Backend",
		date: "2023.11 ~ 2024.02",
		summary: "광고 레퍼런스 이미지·텍스트 검색 서비스 (Founder)",
		responsibilities: [
			"검색 백엔드 설계·구현",
			"Next.js 프론트엔드 구현",
			"로그인·인증, 콜렉션(즐겨찾기) 등 핵심 기능",
			"이미지·텍스트 임베딩 파이프라인 (OpenAI API)",
			"벡터 검색 인덱스 구성·운영 (Faiss/IVFFLAT)",
			"인덱스 갱신·무중단 교체",
			"Docker·Cloud Run 배포·인프라",
			"Supabase(Postgres) 데이터 관리"
		],
		solved: [
			"검색 응답 **3.2s → 0.4s**, 검색 중 이탈 **21% → 6%**",
			"**GPU 없이 CPU 수평확장**으로 비용 절감하며 처리량 확보",
			"검색을 DB(pgvector)에서 **전용 Faiss 인메모리 서버로 분리** — 본 API 영향 차단",
			"인덱스 **무중단 교체** (업데이트 다운타임 0)"
		]
	},
	{
		company: "리베이스 — 지미",
		role: "Founder · Fullstack",
		date: "2022.06 ~ 2023.11",
		summary: "환경 리워드 앱 (누적 27,000+ 다운로드, DAU 1,000+) — 4인 팀 리딩·풀스택",
		responsibilities: [
			"서버·Flutter 풀스택 개발",
			"4인 팀 리딩, 핵심 기능 기획·개발",
			"6개월 26회 배포 운영",
			"포인트·리워드/미션 인증 시스템",
			"푸시 알림·회원/인증 관리",
			"상호평가(커뮤니티 검수) 시스템",
			"피드 기능",
			"CI/CD 파이프라인, 어드민·운영 도구",
			"데이터 기반 의사결정 (리텐션·퍼널 분석)"
		],
		solved: [
			"관리자 검수 미션 **1,000+ → 100+ (약 90%↓)** — 커뮤니티 상호평가 + Redis Lua 동시성으로 자동화",
			"D+1 리텐션 **25.3% → 30.6%**, 평균 체류 **3분 → 6분** (피드 랜덤 페이지네이션·B+ Range Scan)",
			"배포 시간 **30분 → 3분** (CI/CD 자동화)",
			"어뷰징(중복 인증·부정 포인트) 방어 및 트래픽 증가 대응"
		]
	}
];

const projects = [
	{
		company: "Attenz",
		role: "개인 프로젝트",
		date: "2025.04 ~ 2025.05",
		summary: "자연어로 긴 영상을 편집하는 AI (개인 프로젝트)",
		bullets: ["AI 에이전트 기반 영상 분석·편집 파이프라인 설계"]
	}
];
---

<ResumeLayout title={`${cv.header.name} - Resume`} description={`${cv.header.name} Resume`}>
  <div class="flex justify-between items-center mb-4 no-print">
    <a href="/cv" class="text-sm text-blue-600 hover:underline">자세한 이력 (CV) →</a>
    <button onclick="window.print()" class="bg-gray-800 text-white px-4 py-2 rounded-md hover:bg-gray-700 transition-colors text-sm font-medium cursor-pointer">
      Print to PDF
    </button>
  </div>

  <ResumeHeader {...cv.header} />

  <ResumeSection title="Experience">
    {experience.map((exp) => (
      <CvExperienceItem
        company={exp.company}
        role={exp.role}
        date={exp.date}
        summary={exp.summary}
        responsibilities={exp.responsibilities}
        solved={exp.solved}
      />
    ))}
  </ResumeSection>

  <ResumeSection title="Projects">
    {projects.map((p) => (
      <CvExperienceItem company={p.company} role={p.role} date={p.date} summary={p.summary} bullets={p.bullets} />
    ))}
  </ResumeSection>

  <ResumeSection title="Education">
    {cv.education.map((edu) => (
      <ResumeItem title={edu.school} subtitle={edu.degree} date={edu.date} />
    ))}
  </ResumeSection>

  {cv.awards && (
    <ResumeSection title="Awards">
      {cv.awards.map((award) => (
        <ResumeItem title={award.name} subtitle={award.role} date={award.date} />
      ))}
    </ResumeSection>
  )}
</ResumeLayout>
