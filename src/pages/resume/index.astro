---
import { getEntry } from "astro:content";
import ResumeLayout from "../../layouts/ResumeLayout.astro";
import ResumeHeader from "../../components/resume/ResumeHeader.astro";
import CvExperienceItem from "../../components/resume/CvExperienceItem.astro";
import ResumeItem from "../../components/resume/ResumeItem.astro";
import ResumeSection from "../../components/resume/ResumeSection.astro";

const entry = await getEntry("resume", "default");
if (!entry) {
	throw new Error("Default resume not found");
}
const cv = entry.data;

const experience = [
	{
		company: "LG AI Research",
		role: "AI Infrastructure Engineer (Language Lab · Internship)",
		date: "2026.02 ~ 현재",
		summary: "EXAONE 에이전트화·독자 파운데이션 모델(K-EXAONE) 학습을 위한 데이터·인프라 담당",
		bullets: [
			"에이전트를 **최대 8,000+ 동시** 실행하는 학습 데이터 생성 인프라를 EKS·self-hosted Daytona 위에 구축·운영",
			"**빌드 전용 서비스** 직접 설계·구현 (pull 큐 Redis/RQ · KEDA · BuildKit S3 공유 캐시 · content-hash 멱등) — 빌드 대기 **P95 93분→4.4분**, 에러율 **16.3%→0.47%**, 일 비용 **1,500만→200만원(약 7.5배↓)**, 노드 256→32",
			"이미지 레지스트리(Harbor) S3 전환 및 대규모 운영 트러블슈팅 — 현재 **133TB·46만 이미지** 안정 운영",
			"vLLM 서빙 최적화 (SM 사용률·NVLink를 dcgm-exporter로 관측, DP/TP·A100 구성 조정) — 추론 처리량 약 10%↑",
			"Agentic 학습 데이터 파이프라인 자동화(Dagster·2단 검증), Terminal-Bench 중심 SFT·RL Seed 데이터 생성 기여",
			"오픈소스 하네스(Opencode) 내부 분석·개조, 프로세스 누수 버그 진단·해결 후 업스트림 보고"
		]
	},
	{
		company: "씨그로",
		role: "데이터 엔지니어 & 서버 개발",
		date: "2024.05 ~ 2024.09",
		summary: "이커머스 셀러용 멀티채널 분석 대시보드의 데이터 파이프라인·백엔드",
		bullets: [
			"50+ 판매·광고 채널(스마트스토어·쿠팡·Cafe24·Google/Meta Ads 등) 크롤링·ETL 파이프라인 운영",
			"대시보드 집계 조회 **p99 10초→1초** — Aggregate Table 사전집계 + 증분 갱신 도입",
			"반복되던 OOMKilled 장애 근본 해결(메모리 재산정·렌더링 최적화), Loki·Grafana로 장애 인지 자동화"
		]
	},
	{
		company: "리베이스 — 모인나",
		role: "서버 개발 (Founder)",
		date: "2023.11 ~ 2024.02",
		summary: "퍼포먼스 마케터용 텍스트-이미지 검색 서비스 0→1 출시",
		bullets: [
			"벡터 검색을 DB(pgvector)에서 **전용 Faiss 인메모리 검색 서버로 분리** — 검색 응답 **3.2초→0.9초**, 검색 중 이탈률 21%→6%",
			"GCP Cloud Run 기반 컨테이너 수평 확장, 인덱스 무중단 교체 구조 구현"
		]
	},
	{
		company: "리베이스 — 지미",
		role: "풀스택 개발 (Founder)",
		date: "2022.06 ~ 2023.11",
		summary: "환경 리워드 앱 (누적 다운로드 2.7만, 4인 팀 리딩)",
		bullets: [
			"NestJS 계층형 아키텍처로 복잡한 gamification 도메인 로직 관리 (트랜잭션 경계·DI 기반 확장성)",
			"랜덤 페이지네이션 피드(B+ Range Scan)로 DB 부하 최소화 — **D+1 리텐션 25.3%→30.6%**, 평균 체류 3분→6분",
			"Docker·Cloud Run 무중단 배포 CI/CD 구축 — 배포 시간 30분→3분"
		]
	}
];

const projects = [
	{
		company: "Attenz (개인 프로젝트)",
		role: "AI 영상 편집",
		date: "2025.04 ~ 2025.05",
		summary: "자연어로 긴 영상을 편집하는 AI",
		bullets: [
			"LangGraph ReAct 에이전트 + 시멘틱 서치로 필요한 Scene만 LLM에 전달해 컨텍스트·비용 절감",
			"수 분 걸리는 인덱싱을 MongoDB 작업 큐 + Polling 기반 비동기 처리 구조로 설계"
		]
	}
];
---

<ResumeLayout title={`${cv.header.name} - Resume`} description={`${cv.header.name} 경력기술서`}>
  <div class="flex justify-between items-center mb-4 no-print">
    <a href="/cv" class="text-sm text-blue-600 hover:underline">상세 이력 (CV) →</a>
    <button onclick="window.print()" class="bg-gray-800 text-white px-4 py-2 rounded-md hover:bg-gray-700 transition-colors text-sm font-medium cursor-pointer">
      Print to PDF
    </button>
  </div>

  <ResumeHeader {...cv.header} />

  <ResumeSection title="Experience">
    {experience.map((exp) => (
      <CvExperienceItem
        company={exp.company}
        role={exp.role}
        date={exp.date}
        summary={exp.summary}
        bullets={exp.bullets}
      />
    ))}
  </ResumeSection>

  <ResumeSection title="Projects">
    {projects.map((p) => (
      <CvExperienceItem company={p.company} role={p.role} date={p.date} summary={p.summary} bullets={p.bullets} />
    ))}
  </ResumeSection>

  {cv.education && (
    <ResumeSection title="Education">
      {cv.education.map((edu) => (
        <ResumeItem title={edu.school} subtitle={edu.degree} date={edu.date} />
      ))}
    </ResumeSection>
  )}

  {cv.awards && (
    <ResumeSection title="Awards">
      {cv.awards.map((award) => (
        <ResumeItem title={award.name} subtitle={award.role} date={award.date} />
      ))}
    </ResumeSection>
  )}
</ResumeLayout>
