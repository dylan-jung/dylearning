---
import { getEntry } from "astro:content";
import ResumeLayout from "../../layouts/ResumeLayout.astro";
import ResumeHeader from "../../components/resume/ResumeHeader.astro";
import ResumeSection from "../../components/resume/ResumeSection.astro";

const entry = await getEntry("cv", "default");
if (!entry) {
	throw new Error("Default CV not found");
}
const cv = entry.data;

const experience = [
	{
		company: "LG AI Research",
		role: "AI Infrastructure Engineer (Language Lab · Internship)",
		date: "2026.02 ~ 현재",
		summary: "독자 파운데이션 모델(K-EXAONE)·제품 모델(ChatEXAONE) 학습을 위한 데이터 생성·실행 인프라 구축·운영 (확장성·비용·안정성·보안 책임)",
		bullets: [
			"**AI 에이전트 실행 인프라(EKS)**: 에이전트를 샌드박스로 격리하고 KEDA 오토스케일링·스케줄러 가중치 재설계·호스트 권한 격리로 **최대 8,000+ 동시 안정 실행**, 고정 IP 자동화(kubeip)로 화이트리스트 통과·NAT 비용 절감, vLLM 추론 서빙 최적화",
			"**비용·성능 최적화**: 수만 건 실패가 대부분 이미지 빌드·레지스트리 병목임을 규명, 빌드를 실행 경로에서 분리(BuildKit 캐시로 중복 빌드 제거·Harbor 백엔드 S3 전환)해 실패율 **16%→0.5%**·빌드 대기 P95 **93분→4.4분**·운영비 **일 1,500만→200만원(약 7.5배↓)**",
			"**데이터 파이프라인 자동화**: 생성·검증·재시도가 사람 개입 없이 도는 파이프라인을 Dagster로 구축해 **4.4만 건** 자동 생산·생성 비용 **~$1,500→~$500(약 67%↓)**, 모니터링·장애 알림으로 안정 운영",
			"**모델 성능 기여**: 도메인별 SFT·RL 학습 데이터셋으로 담당 도메인 **TB 점수 14.3%→39.3%** 향상에 기여, patch를 실제 repo에 적용·빌드·테스트하는 실행 기반 평가자(Agent Judge) 설계",
			"**오픈소스 기여**: 에이전트 도구(Opencode) 내부 분석·수정 및 프로세스 누수 버그 진단·해결"
		]
	},
	{
		company: "씨그로",
		role: "데이터 엔지니어 & 서버 개발",
		date: "2024.05 ~ 2024.09",
		summary: "이커머스 셀러용 멀티채널 분석 대시보드의 데이터 파이프라인·백엔드 개발·운영",
		bullets: [
			"Prefect 기반 **50개 이상** 판매·광고 채널 크롤링·ETL 파이프라인 개발·운영, 차단 대응을 위한 IP 변경, 프록시 SaaS 도입, 네트워크 구성",
			"분석 대시보드 백엔드 개발, 집계 조회 응답 **p99 10초→1초** 개선",
			"알림톡 발송, 채널별 데이터 정합성 관리 등 서비스 운영·유지보수",
			"잘못 설정된 join 키 등으로 어긋난 데이터를 진단·복구하여 집계 정합성 확보",
			"Kubernetes 기반 크롤링 Job 운영·장애 대응 및 Loki·Grafana 모니터링 체계 구축"
		]
	},
	{
		company: "리베이스 — 모인나",
		role: "서버 개발 (Founder)",
		date: "2023.11 ~ 2024.02",
		summary: "창업 프로젝트로 기획·개발·배포까지 직접 만든 퍼포먼스 마케터용 광고 레퍼런스(텍스트-이미지) 검색 서비스 (DAU 100+)",
		bullets: [
			"광고 레퍼런스 검색 서비스의 백엔드·프론트엔드를 단독 개발",
			"광고 레퍼런스(이미지·카피) 검색을 위해 키워드 검색과 벡터 검색을 결합한 하이브리드 검색 개발",
			"30K+ 이미지·텍스트 임베딩 생성·인덱싱 파이프라인 구축",
			"벡터 검색을 단일 DB(pgvector)에서 전용 Faiss IVFFLAT 인메모리 서버로 분리, 검색 응답 **3.2초→0.9초** 및 이탈률 **21%→6%** 개선",
			"GCP Cloud Run 기반 CPU 수평 확장 및 무중단 인덱스 교체 구조 구현"
		]
	},
	{
		company: "리베이스 — 지미",
		role: "풀스택 개발 (Founder)",
		date: "2022.06 ~ 2023.11",
		summary: "창업 프로젝트로 기획·개발·운영까지 직접 만든 환경 리워드 앱 (누적 다운로드 2.7만, DAU 1,000+)",
		bullets: [
			"환경 리워드 앱을 기획부터 풀스택 개발·운영까지 직접 만들고 4인 팀 리딩, 6개월간 26회 배포",
			"NestJS 계층형 아키텍처 설계 및 미션·포인트·피드 등 핵심 기능 개발",
			"커뮤니티 상호평가로 운영(검수) 자동화 및 어뷰징 방어",
			"Docker·Cloud Run 무중단 배포 CI/CD 구축"
		]
	}
];

const projects = [
	{
		company: "Attenz (개인 프로젝트)",
		role: "AI 영상 편집",
		date: "2025.04 ~ 2025.05",
		summary: "자연어로 긴 영상을 편집하는 AI",
		bullets: ["LangGraph ReAct 에이전트와 시멘틱 서치로 자연어 영상 편집 AI 설계", "장시간 영상 인덱싱을 비동기로 처리하는 구조 설계"]
	}
];

const parseInline = (text: string) =>
	text
		.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank" class="text-blue-600 hover:underline">$1</a>')
		.replace(/\*\*(.*?)\*\*/g, "<strong>$1</strong>");
---

<ResumeLayout title={`${cv.header.name} | Resume`} description={`${cv.header.name} 경력기술서`}>
  <div class="flex justify-between items-center mb-4 no-print">
    <a href="/cv" class="text-sm text-blue-600 hover:underline">상세 이력 (CV) →</a>
    <button onclick="window.print()" class="bg-gray-800 text-white px-4 py-2 rounded-md hover:bg-gray-700 transition-colors text-sm font-medium cursor-pointer">
      Print to PDF
    </button>
  </div>

  <ResumeHeader {...cv.header} />

  {[
    { title: "Experience", items: experience },
    { title: "Projects", items: projects },
  ].map((section) => (
    <ResumeSection title={section.title}>
      {section.items.map((exp) => (
        <div class="mb-4 break-inside-avoid">
          <div class="flex flex-col sm:flex-row sm:justify-between sm:items-baseline">
            <div>
              <div class="font-bold text-gray-900">{exp.company}</div>
              <div class="text-sm text-gray-600">{exp.role}</div>
            </div>
            <span class="text-sm text-gray-500 shrink-0">{exp.date}</span>
          </div>
          {exp.summary && <p class="text-sm text-gray-800 font-medium mt-0.5">{exp.summary}</p>}
          <ul class="list-disc list-outside ml-5 mt-1.5 space-y-1 text-sm text-gray-700 leading-relaxed">
            {exp.bullets.map((bullet) => (
              <li set:html={parseInline(bullet)}></li>
            ))}
          </ul>
        </div>
      ))}
    </ResumeSection>
  ))}

  {cv.education && (
    <ResumeSection title="Education">
      <ul class="list-disc list-outside ml-5 text-sm text-gray-700 leading-relaxed space-y-1">
        {cv.education.map((edu) => (
          <li>{edu.school} · {edu.degree} ({edu.date})</li>
        ))}
      </ul>
    </ResumeSection>
  )}

  <ResumeSection title="Activities">
    <ul class="list-disc list-outside ml-5 text-sm text-gray-700 leading-relaxed space-y-1">
      <li><span class="font-medium text-gray-900">창업·스타트업</span>: 예비창업패키지 선정·정부지원금 수령, 한양대 캠퍼스타운 입주 (리베이스)</li>
      <li><span class="font-medium text-gray-900">대외활동</span>: 소프트웨어 마에스트로 13기 (팀 리더·상위 8%), 시립대 최초 교내 해커톤 ‘플랑크톤’ 주최 (60여 명), 오픈소스 기여 모임 10기 (Spring AI 기여), 클라우드 클럽 9기</li>
      <li><span class="font-medium text-gray-900">병역</span>: 공군 사이버작전센터 (정보보호상황병)</li>
    </ul>
  </ResumeSection>

  {cv.awards && (
    <ResumeSection title="Awards">
      <ul class="list-disc list-outside ml-5 text-sm text-gray-700 leading-relaxed space-y-1">
        {cv.awards.map((award) => (
          <li>{award.name} · {award.role} ({award.date})</li>
        ))}
      </ul>
    </ResumeSection>
  )}
</ResumeLayout>
