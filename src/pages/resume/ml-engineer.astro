const education = [{ school: "서울시립대학교", degree: "컴퓨터과학전공 학사 (GPA 4.12 / 4.5)", date: "2019.03 ~ 2026.08 (졸업 예정)" }];

const awards = [
	{ name: "마이데이터 아이디어 공모전", role: "과학기술정보통신부 장관상", date: "2023.08" },
	{ name: "소프트웨어 마에스트로 13기 우수자", role: "과학기술정보통신부 장관상 · 팀 리더 (팀 전원 상위 8%)", date: "2023.06" }
];

const etcLines = [
	"**오픈소스**: Spring AI 기여 (PR 제출, 리뷰 진행 중)",
	"**창업**: 예비창업패키지 선정·정부지원금 수령, 한양대 캠퍼스타운 입주",
	"**병역**: 공군 사이버작전센터 정보보호상황병 만기 전역"
];

const md = (s: string) =>
	s
		.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank" class="text-blue-600 hover:underline">$1</a>')
		.replace(/\*\*(.*?)\*\*/g, "<strong>$1</strong>");
---

<ResumeLayout title={`${header.name} | NLP Research Engineer`} description={`${header.name} 경력기술서 NLP Research Engineer`}>
  <div class="flex justify-end mb-4 no-print">
    <button onclick="window.print()" class="bg-gray-800 text-white px-4 py-2 rounded-md hover:bg-gray-700 transition-colors text-sm font-medium cursor-pointer">
      Print to PDF
    </button>
  </div>

  <ResumeHeader {...header} />

  <ResumeSection title="Experience">
    {experience.map((exp) => (
      <div class="exp">
        <div class="exp-head">
          <div>
            <h3 class="exp-co">{exp.company}</h3>
            <div class="exp-role">{exp.role}</div>
          </div>
          <span class="exp-date">{exp.date}</span>
        </div>

        <p class="exp-intro">
          <span set:html={md(exp.intro)} />
          {exp.link && <a href={exp.link.url} target="_blank" rel="noopener">{exp.link.text} ↗</a>}
        </p>

        {exp.groups?.map((g, gi) => (
          <div class="grp">
            <div class="grp-head">
              <span class="grp-t">{String(gi + 1).padStart(2, "0")}. {g.title}</span>
              {g.links?.map((l) => <a class="grp-l" href={l.url} target="_blank" rel="noopener">{l.text} ↗</a>)}
              <span class="grp-d">{g.date}</span>
            </div>
            {g.items.map((it) => (
              <div class="it">
                <div class="it-t">{it.title}</div>
                <ul class="star">
                  <li class="it-p"><span class="k">문제.</span> <span set:html={md(it.p)} /></li>
                  <li class="it-a">
                    <span class="k">행동.</span>
                    {Array.isArray(it.a) ? (
                      <ul class="sub">
                        {it.a.map((t) => <li set:html={md(t)} />)}
                      </ul>
                    ) : (
                      <span set:html={md(it.a)} />
                    )}
                  </li>
                  {it.r && <li class="it-r"><span class="k">결과.</span> <span set:html={md(it.r)} /></li>}
                </ul>
              </div>
            ))}
          </div>
        ))}

        {exp.etc && (
          <ul class="bul">
            {exp.etc.map((e) => <li set:html={md(e)} />)}
          </ul>
        )}
      </div>
    ))}
  </ResumeSection>

  <ResumeSection title="Education">
    {education.map((edu) => <ResumeItem title={edu.school} subtitle={edu.degree} date={edu.date} />)}
  </ResumeSection>

  <ResumeSection title="Awards">
    {awards.map((a) => <ResumeItem title={a.name} subtitle={a.role} date={a.date} />)}
  </ResumeSection>

  <ResumeSection title="Etc.">
    <ul class="bul">
      {etcLines.map((e) => <li set:html={md(e)} />)}
    </ul>
  </ResumeSection>
</ResumeLayout>

<style>
	/* ponytail: 유틸리티 클래스 조합보다 이 페이지 전용 CSS가 짧고 인쇄까지 예측 가능해서 직접 씀 */
	.exp {
		margin-bottom: 26px;
	}
	.exp-head {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 12px;
		border-bottom: 1px solid #e5e7eb;
		padding-bottom: 7px;
		margin-bottom: 8px;
	}
	.exp-co {
		margin: 0;
		font-size: 22px;
		font-weight: 800;
		letter-spacing: -0.02em;
		color: #3b3f46;
	}
	.exp-role {
		font-size: 14px;
		font-weight: 600;
		color: #666b74;
	}
	.exp-date {
		flex: none;
		font-size: 13px;
		color: #7d828c;
	}
	.exp-intro {
		margin: 0;
		font-size: 13px;
		line-height: 1.65;
		color: #666b74;
	}
	.exp-intro a {
		margin-left: 4px;
		color: #2563eb;
		white-space: nowrap;
	}

	.grp {
		margin-top: 16px;
		break-inside: avoid;
	}
	.grp-head {
		display: flex;
		align-items: baseline;
		gap: 8px;
		border-left: 3px solid #c6cad1;
		padding-left: 9px;
		-webkit-print-color-adjust: exact;
		print-color-adjust: exact;
	}
	.grp-t {
		font-size: 15px;
		font-weight: 800;
		letter-spacing: -0.02em;
		color: #3b3f46;
	}
	.grp-l {
		font-size: 11.5px;
		color: #2563eb;
		text-decoration: none;
		white-space: nowrap;
	}
	.grp-l:hover {
		text-decoration: underline;
	}
	.grp-d {
		margin-left: auto;
		flex: none;
		font-size: 12px;
		color: #9ca3af;
	}

	.it {
		margin-top: 11px;
		padding-left: 12px;
		break-inside: avoid;
	}
	.it-t {
		font-size: 13.5px;
		font-weight: 700;
		color: #3f434b;
		margin-bottom: 3px;
	}
	ul.star {
		margin: 0;
		padding-left: 18px;
		list-style: disc;
	}
	ul.star > li {
		margin: 0 0 2px;
		font-size: 13px;
		line-height: 1.6;
	}
	ul.star > li::marker {
		color: #c6cad1;
	}
	ul.sub {
		margin: 2px 0 0;
		padding-left: 16px;
		list-style: circle;
	}
	ul.sub > li {
		margin-bottom: 2px;
	}
	ul.sub > li::marker {
		color: #c6cad1;
	}
	.it-p {
		color: #7d828c;
	}
	.it-a {
		color: #555a63;
	}
	.it-r {
		color: #3b3f46;
	}
	.k {
		font-weight: 700;
		text-indent: 0;
		color: #3b3f46;
	}

	ul.bul {
		margin: 12px 0 0;
		padding-left: 18px;
		list-style: disc;
	}
	ul.bul > li {
		margin-bottom: 4px;
		font-size: 13px;
		line-height: 1.65;
		color: #555a63;
	}
	ul.bul > li::marker {
		color: #9ca3af;
	}

	@media print {
		.exp {
			margin-bottom: 18px;
		}
		.it,
		.grp {
			break-inside: avoid;
		}
	}
</style>
