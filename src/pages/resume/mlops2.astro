							"**cgroup 메모리 계측으로 컨테이너 request/limit를 재산정**하고 Headless Browser의 이미지 렌더링을 비활성화해 근본 원인 제거",
							"로그 부재로 원인 분석이 어렵던 환경에 **Loki·Grafana 관측 체계를 구축**, 이상 징후는 Grafana 알림으로 즉시 인지되도록 연동"
						],
						r: "반복되던 OOM 장애 해소, 장애 인지를 수동 확인에서 **알림 기반 체계로 전환**, 디버깅 효율 대폭 개선."
					}
				]
			}
		]
	},
	{
		company: "리베이스 (창업)",
		role: "Founder · 풀스택 개발",
		date: "2022.06 ~ 2024.02",
		intro: "환경 리워드 앱 '지미'(다운로드 27,000+, DAU 1,000+)와 광고 레퍼런스 검색 '모인나'를 창업해 기획부터 운영까지 전 구간 담당.",
		groups: [
			{
				items: [
					{
						title: "모인나: 검색 인프라 구조 재설계 및 성능 최적화 (백엔드 담당)",
						jd: "벡터 검색 시스템 설계, 비용 효율적 서빙",
						bg: "퍼포먼스 마케터들이 여러 플랫폼을 오가며 광고 레퍼런스(이미지·카피)를 수작업으로 수집하는 비효율을 해결하려 만든 텍스트-이미지 검색 툴. 베타 200+명 운영.",
						p: "검색 응답이 평균 3초 이상 걸리며 **검색 과정에서 21%가 이탈**. 이미지+텍스트 30K+ 임베딩을 단일 DB(pgvector)에서 처리하는 구조라 **CPU 병목**이 발생했고, 검색 트래픽이 다른 트랜잭션성 API 성능까지 끌어내리고 있었음.",
						a: [
							"단일 DB 기반 pgvector 검색은 처리량·확장성에 한계가 있다고 판단, 검색 워크로드가 다른 API에 영향을 주지 않도록 **검색 기능을 완전히 분리**하는 방향으로 결정. GPU는 서비스 규모 대비 비용 부담이 커 **CPU 기반 수평 확장 유지**",
							"**FastAPI + Faiss 전용 검색 서버**를 구축해 IVFFLAT 인덱스를 인메모리로 운영, **Cloud Run 컨테이너 단위 수평 확장** 구성. 인덱스 갱신은 새 인덱스 다운로드 완료 후 교체하는 **무중단 갱신** 구조로 구현"
						],
						r: "검색 응답 평균 **3.2초 → 0.9초**, 검색 중 이탈률 **21% → 6%**. GPU 도입 없이 비용 효율적인 임베딩 검색 시스템 확보.",
						link: { text: "자세한 고민 과정", url: "https://blog.dylearning.com/note/designing-a-image-search-system-2" }
					}
				]
			}
		],
		etc: [
			"**지미**: GitHub Actions·Artifact Registry·Cloud Run을 연계한 CI/CD로 배포를 전 과정 자동화 (배포 시간 30분 → 3분), ORDER BY RAND() 풀스캔 피드를 세션 Seed 기반 랜덤 페이지네이션으로 재설계 → D+1 리텐션 **25.3% → 30.6%**"
		]
	}
];

const education = [{ school: "서울시립대학교", degree: "컴퓨터과학전공 학사 (GPA 4.12 / 4.5 · 우등 졸업)", date: "2019.03 ~ 2026.08" }];

const awards = [
	{ name: "우등 졸업 (Magna Cum Laude)", role: "서울시립대학교", date: "2026.08" },
	{ name: "마이데이터 아이디어 공모전", role: "과학기술정보통신부 장관상", date: "2023.08" },
	{ name: "소프트웨어 마에스트로 13기 우수자 선정", role: "과학기술정보통신부 장관상", date: "2023.06" },
	{ name: "TOPCIT 우수 성적상", role: "Level 4 / 한전KDN주식회사상 (680점)", date: "2022.12" },
	{ name: "공군 사이버전사 경연대회", role: "대령급 상장 수상", date: "2021" }
];

const etcLines = [
	"**창업·스타트업**: 예비창업패키지 선정·정부지원금 수령, 한양대 캠퍼스타운 입주 (리베이스)",
	"**대외활동**: 소프트웨어 마에스트로 13기 (팀 리더·상위 8%), 시립대 최초 교내 해커톤 '플랑크톤' 주최 (60여 명), 오픈소스 기여 모임 10기, 클라우드 클럽 9기"
];

const md = (s: string) =>
	s
		.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank" class="text-blue-600 hover:underline">$1</a>')
		.replace(/\*\*(.*?)\*\*/g, "<strong>$1</strong>");
---

<ResumeLayout title={`${header.name} | ML Engineer`} description={`${header.name} 경력기술서 ML Engineer`}>
  <div class="flex justify-end mb-4 no-print">
    <button onclick="window.print()" class="bg-gray-800 text-white px-4 py-2 rounded-md hover:bg-gray-700 transition-colors text-sm font-medium cursor-pointer">
      Print to PDF
    </button>
  </div>

  <ResumeHeader {...header} />

  <ResumeSection title="Career Timeline">
    <ResumeTimeline items={careers} />
  </ResumeSection>

  <ResumeSection title="Experience">
    {experience.map((exp) => (
      <div class="exp">
        <div class="exp-head">
          <div>
            <h3 class="exp-co">{exp.company}</h3>
            <div class="exp-role">{exp.role}</div>
          </div>
          <span class="exp-date">{exp.date}</span>
        </div>

        <p class="exp-intro">
          <span set:html={md(exp.intro)} />
          {exp.link && <a href={exp.link.url} target="_blank" rel="noopener">{exp.link.text} ↗</a>}
        </p>

        {exp.groups?.map((g, gi) => (
          <div class="grp">
            {g.title && (
              <div class="grp-head">
                <span class="grp-t">{String(gi + 1).padStart(2, "0")}. {g.title}</span>
                {g.links?.map((l) => <a class="grp-l" href={l.url} target="_blank" rel="noopener">{l.text} ↗</a>)}
                <span class="grp-d">{g.date}</span>
              </div>
            )}
            {g.items.map((it) => (
              <div class="it">
                <div class="it-t">{it.title}</div>
                {it.jd && <p class="it-jd">↳ {it.jd}</p>}
                {it.flow && (
                  <div class="flow">
                    {it.flow.map((f) => (
                      <p><b>{f.k}</b> <span set:html={md(f.v)} /></p>
                    ))}
                  </div>
                )}
                <ul class="star">
                  {it.bg && <li class="it-bg"><span class="k">배경.</span> <span set:html={md(it.bg)} /></li>}
                  <li class="it-p"><span class="k">문제.</span> <span set:html={md(it.p)} /></li>
                  <li class="it-a">
                    <span class="k">해결.</span>
                    {Array.isArray(it.a) ? (
                      <ul class="sub">
                        {it.a.map((t) => <li set:html={md(t)} />)}
                      </ul>
                    ) : (
                      <span set:html={md(it.a)} />
                    )}
                  </li>
                  {it.r && <li class="it-r"><span class="k">결과.</span> <span set:html={md(it.r)} /></li>}
                  {it.link && <li class="it-link"><a href={it.link.url} target="_blank" rel="noopener">{it.link.text} ↗</a></li>}
                </ul>
              </div>
            ))}
          </div>
        ))}

        {exp.etc && (
          <ul class="bul">
            {exp.etc.map((e) => <li set:html={md(e)} />)}
          </ul>
        )}
      </div>
    ))}
  </ResumeSection>

  <ResumeSection title="Education">
    {education.map((edu) => <ResumeItem title={edu.school} subtitle={edu.degree} date={edu.date} />)}
  </ResumeSection>

  <ResumeSection title="Awards">
    <ul class="award-list">
      {awards.map((a) => <li>{a.name} · {a.role} ({a.date})</li>)}
    </ul>
  </ResumeSection>

  <ResumeSection title="Etc.">
    <ul class="bul">
      {etcLines.map((e) => <li set:html={md(e)} />)}
    </ul>
  </ResumeSection>
</ResumeLayout>

<style>
	/* ponytail: 유틸리티 클래스 조합보다 이 페이지 전용 CSS가 짧고 인쇄까지 예측 가능해서 직접 씀 */
	.exp {
		margin-bottom: 26px;
	}
	.exp-head {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 12px;
		margin-bottom: 4px;
	}
	.exp-co {
		margin: 0;
		font-size: 16px;
		font-weight: 700;
		color: #111318;
	}
	.exp-role {
		font-size: 13px;
		font-weight: 400;
		color: #3f444c;
	}
	.exp-date {
		flex: none;
		font-size: 13px;
		color: #565b64;
	}
	.exp-intro {
		margin: 0;
		font-size: 13px;
		line-height: 1.65;
		color: #33363d;
	}
	.exp-intro a {
		margin-left: 4px;
		color: #2563eb;
		white-space: nowrap;
	}

	.grp {
		margin-top: 16px;
	}
	.grp-head {
		display: flex;
		align-items: baseline;
		gap: 8px;
		border-left: 3px solid #c6cad1;
		padding-left: 9px;
		-webkit-print-color-adjust: exact;
		print-color-adjust: exact;
	}
	.grp-t {
		font-size: 15px;
		font-weight: 800;
		letter-spacing: -0.02em;
		color: #111318;
	}
	.grp-l {
		font-size: 11.5px;
		color: #2563eb;
		text-decoration: none;
		white-space: nowrap;
	}
	.grp-l:hover {
		text-decoration: underline;
	}
	.grp-d {
		margin-left: auto;
		flex: none;
		font-size: 12px;
		color: #565b64;
	}

	.it {
		margin-top: 11px;
		padding-left: 12px;
	}
	.it-t {
		font-size: 13.5px;
		font-weight: 700;
		color: #111318;
		margin-bottom: 3px;
	}
	.it-jd {
		margin: 0 0 4px;
		font-size: 11.5px;
		color: #3757c4;
	}

	.flow {
		margin: 4px 0 7px;
		padding: 8px 13px;
		background: #f4f5f7;
		border-radius: 8px;
		font-size: 12.5px;
		line-height: 1.7;
		-webkit-print-color-adjust: exact;
		print-color-adjust: exact;
	}
	.flow p {
		margin: 0;
		color: #24272c;
	}
	.flow b {
		display: inline-block;
		width: 30px;
		color: #111318;
	}

	li.it-link {
		list-style: none;
		font-size: 12px;
		margin-top: 1px;
	}
	li.it-link a {
		color: #3757c4;
		text-decoration: none;
	}
	li.it-link a:hover {
		text-decoration: underline;
	}

	ul.star {
		margin: 0;
		padding-left: 18px;
		list-style: disc;
	}
	ul.star > li {
		margin: 0 0 2px;
		font-size: 13px;
		line-height: 1.6;
	}
	ul.star > li::marker {
		color: #c6cad1;
	}
	ul.sub {
		margin: 2px 0 0;
		padding-left: 16px;
		list-style: circle;
	}
	ul.sub > li {
		margin-bottom: 2px;
	}
	ul.sub > li::marker {
		color: #c6cad1;
	}
	.it-bg {
		color: #565b64;
	}
	.it-p {
		color: #33363d;
	}
	.it-a {
		color: #1a1d22;
	}
	.it-r {
		color: #111318;
	}
	.k {
		font-weight: 700;
		text-indent: 0;
		color: #111318;
	}

	ul.bul {
		margin: 12px 0 0;
		padding-left: 0;
		list-style: none;
	}
	ul.bul > li {
		margin-bottom: 4px;
		font-size: 13px;
		line-height: 1.65;
		color: #1a1d22;
	}
	ul.bul > li::marker {
		color: #9ca3af;
	}

	.award-list {
		margin: 0;
		padding-left: 18px;
		list-style: disc;
	}
	.award-list li {
		font-size: 13px;
		line-height: 1.65;
		color: #1a1d22;
		margin-bottom: 3px;
	}
	.award-list li::marker {
		color: #9ca3af;
	}

	@media print {
		/* ResumeLayout의 * { color: black !important } 를 되돌리는 색 복원 */
		.it-jd {
			color: #3757c4 !important;
		}
		.grp-l,
		li.it-link a,
		.exp-intro a {
			color: #2563eb !important;
		}
		.flow {
			background: #f4f5f7 !important;
			-webkit-print-color-adjust: exact;
			print-color-adjust: exact;
		}
		.it-bg,
		.it-p {
			color: #565b64 !important;
		}
		.grp-d,
		.exp-date {
			color: #565b64 !important;
		}

		.exp {
			margin-bottom: 18px;
		}
	}
</style>
